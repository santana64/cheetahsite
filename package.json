{
  "name": "cheetahsoft-site-vitrine",
  "version": "1.0.0",
  "description": "CheetahSoft — Suite de pilotage projet (Cost, Time, Doc)",
  "private": true,
  "main": "electron/main.js",
  "author": "CheetahSoft",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build",
    "electron": "electron .",
    "electron:build": "next build && electron-builder --win --x64",
    "dist": "next build && electron-builder --win --x64"
  },
  "dependencies": {
    "@uidotdev/usehooks": "^2.4.1",
    "framer-motion": "^12.15.0",
    "gsap": "^3.13.0",
    "next": "14.2.29",
    "react": "^18",
    "react-dom": "^18",
    "react-lottie-player": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.21",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "build": {
    "appId": "fr.cheetahsoft.site-vitrine",
    "productName": "CheetahSoft",
    "copyright": "© 2026 CheetahSoft",
    "directories": {
      "output": "dist-app"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo-cheetahsoft.jpg",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "portable": {
      "artifactName": "CheetahSoft-${version}-Windows.exe"
    }
  }
}
