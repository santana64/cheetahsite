{
  "name": "cheetahsoft-site-vitrine",
  "version": "1.0.0",
  "description": "CheetahSoft — site vitrine (Cost, Time, Doc)",
  "private": true,
  "main": "electron/main.js",
  "author": "CheetahSoft",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "export": "next build",
    "electron": "electron .",
    "electron:build": "next build && electron-builder --win --x64",
    "dist": "next build && electron-builder --win --x64",
    "verify": "node scripts/verify.mjs",
    "perf": "node scripts/perf.mjs",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.3",
    "@react-three/fiber": "^8.17.10",
    "next": "14.2.29",
    "react": "^18",
    "react-dom": "^18",
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/three": "^0.169.0",
    "autoprefixer": "^10.4.21",
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "eslint": "^8",
    "eslint-config-next": "14.2.29",
    "playwright": "^1.49.1",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^5"
  },
  "build": {
    "appId": "fr.cheetahsoft.site-vitrine",
    "productName": "CheetahSoft",
    "copyright": "© 2026 CheetahSoft",
    "directories": {
      "output": "dist-release"
    },
    "files": [
      "electron/**/*",
      "out/**/*",
      "public/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "public/logo-cheetah-256.png",
      "signingHashAlgorithms": null,
      "sign": null
    },
    "portable": {
      "artifactName": "CheetahSoft-${version}-Windows.exe"
    }
  }
}
