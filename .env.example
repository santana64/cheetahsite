# Copier en .env.local pour le développement, ou renseigner dans les variables
# d'environnement de la plateforme de déploiement.
#
# Toutes ces valeurs sont lues au build et inlinées dans le JavaScript client.
# Elles sont donc PUBLIQUES par conception. Ne mettez jamais ici un secret d'API,
# une clé privée ou un mot de passe : il serait lisible par n'importe qui.

# ── Publication ──────────────────────────────────────────────────────────
# Origine publique du site, utilisée par sitemap.xml et robots.txt.
NEXT_PUBLIC_SITE_URL=https://site-vitrine-six-pi.vercel.app

# Préfixe de chemin. Uniquement pour un hébergement en sous-répertoire
# (GitHub Pages). Laisser vide sur Vercel ou sur un domaine dédié.
NEXT_PUBLIC_BASE_PATH=

# ── Formulaire de contact ────────────────────────────────────────────────
# Le site est un export statique : il n'a pas de serveur pour recevoir une
# soumission. L'envoi passe donc par un service tiers d'acheminement de
# formulaires.
#
# Tant que NEXT_PUBLIC_FORM_ENDPOINT est vide, le formulaire reste fonctionnel
# mais bascule sur la composition d'un message dans la messagerie du visiteur,
# et l'interface l'annonce explicitement. Rien ne casse, rien ne ment.
#
# Exemples selon le prestataire :
#   Web3Forms  ENDPOINT=https://api.web3forms.com/submit
#              ACCESS_KEY=<votre clé publique>
#   Formspree  ENDPOINT=https://formspree.io/f/<votre identifiant>
#              ACCESS_KEY=   (non utilisé)
#
# Pensez à compléter la page /confidentialite/ avec l'identité du prestataire
# retenu, son pays d'établissement et les durées de conservation : l'encart
# « Information à fournir par l'éditeur » y attend ces éléments.
NEXT_PUBLIC_FORM_ENDPOINT=
NEXT_PUBLIC_FORM_ACCESS_KEY=
