# Copier en .env.local pour le développement, ou renseigner dans les variables
# d'environnement de la plateforme de déploiement.
#
# Toutes ces valeurs sont lues au build et inlinées dans le JavaScript client.
# Elles sont donc PUBLIQUES par conception. Ne mettez jamais ici un secret d'API,
# une clé privée ou un mot de passe : il serait lisible par n'importe qui.

# ── Publication ──────────────────────────────────────────────────────────
# Origine publique du site, utilisée par sitemap.xml et robots.txt.
NEXT_PUBLIC_SITE_URL=https://site-vitrine-six-pi.vercel.app

# Préfixe de chemin. Uniquement pour un hébergement en sous-répertoire
# (GitHub Pages). Laisser vide sur Vercel ou sur un domaine dédié.
NEXT_PUBLIC_BASE_PATH=

# ── Formulaire de contact (Web3Forms) ────────────────────────────────────
# Le site est un export statique : il n'a pas de serveur pour recevoir une
# soumission. L'envoi passe par Web3Forms.
#
# Pour obtenir la clé : créer un formulaire sur web3forms.com avec l'adresse
# de réception voulue ; la clé d'accès est envoyée par e-mail. Elle est publique
# par conception — la documentation de l'éditeur précise qu'elle peut figurer
# dans une page.
#
# Tant que cette clé est vide, le formulaire reste fonctionnel mais bascule sur
# la composition d'un message dans la messagerie du visiteur, et l'interface
# l'annonce explicitement. Rien ne casse, rien ne ment.
NEXT_PUBLIC_FORM_ACCESS_KEY=

# URL de dépôt. Inutile de la renseigner pour Web3Forms : la valeur par défaut
# est https://api.web3forms.com/submit. À ne remplir que pour changer de
# prestataire, auquel cas vérifier que le contrat attendu correspond
# (access_key dans le corps, réponse 200 en cas de succès).
NEXT_PUBLIC_FORM_ENDPOINT=

# Après activation, compléter la page /confidentialite/ : l'encart
# « Information à fournir par l'éditeur » attend l'entité exploitant Web3Forms,
# son pays de traitement et les durées de conservation.
